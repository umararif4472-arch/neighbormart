rules_version = '2';

// NeighborMart — Cloud Storage rules (Phase 3; uploads arrive in Phase 4)
//
// Listing photos live under listings/{listingId}/... Only the listing's
// owner can write or delete; reads are public so cards and galleries can
// render without signed URLs. Writes are images only, max 5 MB each —
// the same limits the Phase 4 uploader enforces client-side.

service firebase.storage {
  match /b/{bucket}/o {
    match /listings/{listingId}/{fileName} {
      function isListingOwner() {
        return request.auth != null
          && firestore.get(
            /databases/(default)/documents/listings/$(listingId)
          ).data.ownerId == request.auth.uid;
      }

      allow read: if true;
      allow write: if isListingOwner()
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isListingOwner();
    }

    // Avatars live under avatars/{uid}/... and are owner-only writes.
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
