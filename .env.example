# Copy this file to `.env.local` and fill in your own values.
# Never commit `.env.local` or any real secret. Every variable used by the
# web app is prefixed with VITE_ (Vite only exposes prefixed variables to
# the browser bundle — anything here is therefore public by design, and real
# protection comes from Firebase Security Rules, not from hiding these keys).
#
# Phase 1 note: the app currently runs on its in-memory mock service layer
# and needs NO variables set. The Firebase variables below become required
# in Phase 3, when the mock layer is replaced with Firebase.

# --- Firebase (Phase 3: Auth + Firestore + Storage) ---
# Firebase Console → Project settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: only if Firebase Analytics is enabled for the project
VITE_FIREBASE_MEASUREMENT_ID=

# --- App defaults ---
# Default currency for prices when a listing does not specify one.
VITE_DEFAULT_CURRENCY=PKR
