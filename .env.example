# Copy this file to `.env.local` and fill in your own values.
# Never commit `.env.local` or any real secret. Every variable used by the
# web app is prefixed with VITE_ (Vite only exposes prefixed variables to
# the browser bundle — anything here is therefore public by design, and real
# protection comes from Firebase Security Rules, not from hiding these keys).
#
# Phase 3 note: with these variables set, the app runs on the live
# Firebase backend (Auth + Firestore). With them unset, it falls back to
# the in-memory mock service layer — which is how local dev, unit tests,
# and CI run. Set them in `.env.local` for the real backend.

# --- Firebase (Phase 3: Auth + Firestore + Storage) ---
# Firebase Console → Project settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: only if Firebase Analytics is enabled for the project
VITE_FIREBASE_MEASUREMENT_ID=

# --- Cloudinary (Phase 4: photo uploads) ---
# Photo storage lives on Cloudinary's free tier (Firebase Storage needs
# the paid Blaze plan). Uploads are UNSIGNED through a restricted preset
# (images only, 5 MB max, fixed folder) — that is why both values below
# are safe to ship in the browser bundle. The Cloudinary API key/secret
# must NEVER be put here (or anywhere in the frontend); signed operations
# like destroying an asset stay server-side/admin-only.
# Cloudinary Console → Dashboard shows the cloud name; the preset is
# created under Settings → Upload → Upload presets (see
# docs/cloudinary-setup.md for the exact clicks).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=neighbormart_listings

# --- App defaults ---
# Default currency for prices when a listing does not specify one.
VITE_DEFAULT_CURRENCY=PKR
