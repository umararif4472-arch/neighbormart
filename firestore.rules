rules_version = '2';

// NeighborMart — Firestore Security Rules (Phase 3)
//
// These rules are the server-side enforcement of the same business rules
// the service layer checks in code:
//   - profiles are public; only the owner writes their own profile
//   - only a listing's owner can edit it, and status must follow the
//     listing state machine (utils/listingStatus.ts)
//   - requests: no self-booking, participants only, status must follow
//     the request lifecycle (utils/requestLifecycle.ts)
//   - one review per party per deal — review doc ids are deterministic
//     (`${requestId}_${reviewerId}`) and create-only-if-absent
//   - messages only between a request's two participants
//   - notifications are private to their recipient
//   - reports are write-only for users (moderation reads them in the
//     Firebase console / Admin SDK)
//
// Known limit, by design for this release: field-level stat deltas on
// user profiles (e.g. "successfulBorrows may only increase by 1") are
// not verified here — the service layer computes them, and a future
// Cloud Functions pass (Phase 8 hardening) can lock them down.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Deal-stat fan-out (Phase 10 fix): when a deal finishes, the
    // service batch updates BOTH parties' profiles — including the
    // other party's doc, which the owner-only rule below would deny
    // (and did: the E2E return flow failed permission-denied, taking
    // the whole atomic batch down with it). This branch allows ONLY
    // a stats-only diff where every counter stays or rises by
    // exactly 1 and none goes negative — one deal's worth per write,
    // and no profile field can change through it.
    function statFieldOk(oldStats, newStats, key) {
      return newStats.get(key, 0) is int
        && newStats.get(key, 0) >= 0
        && (newStats.get(key, 0) == oldStats.get(key, 0)
          || newStats.get(key, 0) == oldStats.get(key, 0) + 1);
    }

    function statsDeltaOk(oldData, newData) {
      let oldStats = oldData.get('stats', {});
      let newStats = newData.get('stats', {});
      return newStats.keys().hasOnly([
          'successfulLends', 'successfulBorrows', 'salesCompleted',
          'rentalsHosted', 'onTimeReturns', 'lateReturns'])
        && statFieldOk(oldStats, newStats, 'successfulLends')
        && statFieldOk(oldStats, newStats, 'successfulBorrows')
        && statFieldOk(oldStats, newStats, 'salesCompleted')
        && statFieldOk(oldStats, newStats, 'rentalsHosted')
        && statFieldOk(oldStats, newStats, 'onTimeReturns')
        && statFieldOk(oldStats, newStats, 'lateReturns');
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Phase 8 moderation: an account is an admin when its profile doc
    // carries role == 'admin'. Granted manually in Firestore — the
    // users rules below stop anyone promoting themselves.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'member') == 'admin';
    }

    // Phase 9: suspended accounts cannot create listings, requests or
    // messages. A missing profile doc counts as not suspended (profile
    // docs are created at sign-in, before any create can happen).
    function notSuspended() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) != true;
    }

    // Phase 8 rate limits. The client bumps a counter doc
    // (rateLimits/{uid}) BEFORE creating, binding it to the new doc's
    // id. A create is allowed only when the counter names THIS doc and
    // the window count is in range — skipping the bump skips the create.
    function listingQuotaOk(listingId) {
      let rl = get(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data;
      return rl.get('lastListingId', '') == listingId
        && rl.get('listingsCount', 0) is int
        && rl.get('listingsCount', 0) >= 1
        && rl.get('listingsCount', 0) <= 10
        && rl.get('listingsWindowStartTs', timestamp.date(1970, 1, 1)) is timestamp
        && rl.listingsWindowStartTs > request.time - duration.value(24, 'h');
    }

    function messageQuotaOk(messageId) {
      let rl = get(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data;
      return rl.get('lastMessageId', '') == messageId
        && rl.get('messagesCount', 0) is int
        && rl.get('messagesCount', 0) >= 1
        && rl.get('messagesCount', 0) <= 30
        && rl.get('messagesWindowStartTs', timestamp.date(1970, 1, 1)) is timestamp
        && rl.messagesWindowStartTs > request.time - duration.value(60, 's');
    }

    // Listing status machine — mirrors LISTING_STATUS_TRANSITIONS.
    function listingTransitionOk(from, to) {
      return (from == 'active' && to in ['reserved', 'rented', 'sold', 'paused', 'removed'])
        || (from == 'reserved' && to in ['active', 'rented', 'sold', 'removed'])
        || (from == 'rented' && to in ['active', 'removed'])
        || (from == 'sold' && to in ['removed'])
        || (from == 'paused' && to in ['active', 'removed']);
    }

    // Request lifecycle — mirrors REQUEST_TRANSITIONS.
    function requestTransitionOk(from, to) {
      return (from == 'pending' && to in ['approved', 'declined', 'cancelled'])
        || (from == 'approved' && to in ['active', 'cancelled', 'completed'])
        || (from == 'active' && to in ['returned'])
        || (from == 'returned' && to in ['reviewed'])
        || (from == 'completed' && to in ['reviewed']);
    }

    // Listing photos (Phase 4) — every photo must be an uploaded
    // Cloudinary URL from OUR cloud (the cloud name is public by
    // design), within the per-section cap. Updates may keep existing
    // photos untouched (the seed catalog predates Cloudinary — its
    // picsum URLs stay valid while unchanged), but any NEW or EDITED
    // photo set must be all-Cloudinary.
    function photoCap(section) {
      return section == 'vehicles' ? 15 : section == 'properties' ? 20 : 10;
    }

    // Rules has no working list comprehension for this (`.all()` errors
    // at runtime, and rule functions cannot recurse), so the per-photo
    // check is unrolled to the maximum cap (20 = properties).
    function photoAtIsCloudinary(data, i) {
      return data.get('photos', []).size() <= i
        || (data.get('photos', [])[i] is string
          && data.get('photos', [])[i].matches('https://res\\.cloudinary\\.com/sgwcguwo/image/upload/.*'));
    }

    function photosValid(data) {
      return data.get('photos', []) is list
        && data.get('photos', []).size() <= photoCap(data.section)
        && photoAtIsCloudinary(data, 0) &&
        photoAtIsCloudinary(data, 1) &&
        photoAtIsCloudinary(data, 2) &&
        photoAtIsCloudinary(data, 3) &&
        photoAtIsCloudinary(data, 4) &&
        photoAtIsCloudinary(data, 5) &&
        photoAtIsCloudinary(data, 6) &&
        photoAtIsCloudinary(data, 7) &&
        photoAtIsCloudinary(data, 8) &&
        photoAtIsCloudinary(data, 9) &&
        photoAtIsCloudinary(data, 10) &&
        photoAtIsCloudinary(data, 11) &&
        photoAtIsCloudinary(data, 12) &&
        photoAtIsCloudinary(data, 13) &&
        photoAtIsCloudinary(data, 14) &&
        photoAtIsCloudinary(data, 15) &&
        photoAtIsCloudinary(data, 16) &&
        photoAtIsCloudinary(data, 17) &&
        photoAtIsCloudinary(data, 18) &&
        photoAtIsCloudinary(data, 19);
    }

    function photosUnchangedOrValid(newData, oldData) {
      return newData.get('photos', []) == oldData.get('photos', [])
        || photosValid(newData);
    }

    // --- User profiles -----------------------------------------------------
    match /users/{uid} {
      allow read: if true;
      allow create: if isUser(uid);
      // Owners manage their own profile but can never change their own
      // role (no self-promotion to admin).
      allow update: if isUser(uid)
        && request.resource.data.get('role', 'member') == resource.data.get('role', 'member');
      // Deal-stat fan-out: a deal participant may apply one deal's
      // stat increments to the OTHER party's doc (see statsDeltaOk).
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['stats'])
        && statsDeltaOk(resource.data, request.resource.data);
      // Admin actions (Phase 9): an admin may suspend/warn another user
      // or grant/revoke the admin role. isAdmin() reads the CALLER's
      // doc, so a non-admin can never reach these branches — and the
      // owner rule above still freezes everyone's own role.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['suspended', 'warnings']);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['role']);
      // Account deletion (Phase 8): owners may delete their own profile.
      // Admin user management (Phase 9): admins may also delete a profile.
      allow delete: if isUser(uid) || isAdmin();
    }

    // --- Listings ----------------------------------------------------------
    match /listings/{listingId} {
      allow read: if true;
      allow create: if signedIn()
        && notSuspended()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active'
        && photosValid(request.resource.data)
        && listingQuotaOk(listingId);
      allow update: if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          // The owner can edit anything, with status following the machine.
          (resource.data.ownerId == request.auth.uid
            && photosUnchangedOrValid(request.resource.data, resource.data)
            && (request.resource.data.status == resource.data.status
              || listingTransitionOk(resource.data.status, request.resource.data.status)))
          // A deal participant (the borrower) may flip ONLY the status for
          // pickup (active -> rented) and return (rented -> active), which
          // the request lifecycle performs in a batch with the request
          // update. Content fields are untouchable. Residual risk: a
          // signed-in user could flip a status without a real deal — the
          // flip is reversible by the owner and content is never at risk;
          // Phase 8 moves these two transitions into a Cloud Function.
          || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'updatedAt'])
            && ((resource.data.status == 'active' && request.resource.data.status == 'rented')
              || (resource.data.status == 'rented' && request.resource.data.status == 'active')))
          // A moderator resolving a report may take a listing down —
          // status flips to 'removed' and nothing else changes.
          || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'featured', 'updatedAt']))
        );
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // --- Borrow / booking requests -----------------------------------------
    // Docs carry a denormalized ownerId (the listing owner) alongside the
    // model fields so participant checks need no extra reads.
    match /requests/{requestId} {
      allow read: if signedIn()
        && (resource.data.borrowerId == request.auth.uid
          || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn()
        && notSuspended()
        && request.resource.data.borrowerId == request.auth.uid
        && request.resource.data.ownerId != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && (resource.data.borrowerId == request.auth.uid
          || resource.data.ownerId == request.auth.uid)
        && request.resource.data.borrowerId == resource.data.borrowerId
        && request.resource.data.ownerId == resource.data.ownerId
        && (request.resource.data.status == resource.data.status
          || (requestTransitionOk(resource.data.status, request.resource.data.status)
            // Role split inside the lifecycle: only the owner approves,
            // declines, or completes a deal; only the borrower cancels.
            // Pickup / return / review-completion may be recorded by
            // either participant.
            && (request.resource.data.status in ['approved', 'declined', 'completed']
              ? resource.data.ownerId == request.auth.uid
              : request.resource.data.status == 'cancelled'
                ? resource.data.borrowerId == request.auth.uid
                : true)));
      allow delete: if false;
    }

    // --- Reviews -------------------------------------------------------------
    match /reviews/{reviewId} {
      allow read: if true;
      // One review per party per deal: the deterministic id makes a
      // second create land on an existing doc, which `create` forbids.
      allow create: if signedIn()
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    // --- Chat messages -------------------------------------------------------
    match /messages/{messageId} {
      function isParticipant(reqData) {
        return reqData.borrowerId == request.auth.uid
          || reqData.ownerId == request.auth.uid;
      }
      allow read: if signedIn()
        && isParticipant(
          get(/databases/$(database)/documents/requests/$(resource.data.requestId)).data
        );
      allow create: if signedIn()
        && notSuspended()
        && request.resource.data.senderId == request.auth.uid
        && isParticipant(
          get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data
        )
        && messageQuotaOk(messageId);
      allow update, delete: if false;
    }

    // --- Notifications --------------------------------------------------------
    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      // Any signed-in user can notify another (deal fan-out); the content
      // shape is validated so this can't become a spam firehose of junk.
      allow create: if signedIn()
        && request.resource.data.userId is string
        && request.resource.data.title is string
        && request.resource.data.read == false;
    }

    // --- Reports (moderation queue) -------------------------------------------
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.status == 'open';
      // Phase 8 moderation: admins work the queue in-app. Resolution
      // may only move status to dismissed/actioned.
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['dismissed', 'actioned'];
      allow delete: if false;
    }

    // --- Rate-limit counters (Phase 8) ---------------------------------------
    // Phase 9 audit log: admins read it; admins append entries about
    // their own actions; nobody can edit or delete history.
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.adminId == request.auth.uid
        && request.resource.keys().hasOnly(['adminId', 'action', 'targetType', 'targetId', 'detail', 'createdAt']);
      allow update, delete: if false;
    }

    match /rateLimits/{uid} {
      allow read: if isUser(uid);
      // Owner-only; counts may rise by at most 1 per write or reset to
      // 1 when a window rolls over. Only the six counter fields exist.
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly([
          'listingsCount', 'listingsWindowStartTs', 'lastListingId',
          'messagesCount', 'messagesWindowStartTs', 'lastMessageId'])
        && request.resource.data.get('listingsCount', 0) is int
        && request.resource.data.get('messagesCount', 0) is int
        && (resource == null
          || ((request.resource.data.get('listingsCount', 0) == resource.data.get('listingsCount', 0)
              || request.resource.data.get('listingsCount', 0) == resource.data.get('listingsCount', 0) + 1
              || request.resource.data.get('listingsCount', 0) == 1)
            && (request.resource.data.get('messagesCount', 0) == resource.data.get('messagesCount', 0)
              || request.resource.data.get('messagesCount', 0) == resource.data.get('messagesCount', 0) + 1
              || request.resource.data.get('messagesCount', 0) == 1)));
      allow delete: if false;
    }
  }
}
