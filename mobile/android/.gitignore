# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
# Exception: the shared DEBUG keystore is committed on purpose (standard
# public debug credentials, password "android") so every CI build signs
# with the same SHA-1 that is registered in Firebase for Google Sign-In.
!debug.keystore
